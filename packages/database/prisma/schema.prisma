generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  USER
  MANAGER
  ADMIN
}

enum StepCode {
  BASE
  STEP_1
  STEP_2
  STEP_3
  STEP_4
}

enum QualificationType {
  COURSE
  KNOWLEDGE
  TENURE
  EXPERIENCE
}

enum QualificationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum PromotionStatus {
  DRAFT
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles     Role[]
  users     User[]
}

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  passwordHash        String
  systemRole          SystemRole @default(USER)
  hiredAt             DateTime
  professionalSince   DateTime?
  active              Boolean    @default(true)
  teamId              String
  roleId              String?
  currentRoleStepId   String?
  managerId           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  team                Team       @relation(fields: [teamId], references: [id])
  role                Role?      @relation(fields: [roleId], references: [id])
  currentRoleStep     RoleStep?  @relation("CurrentRoleStep", fields: [currentRoleStepId], references: [id])
  manager             User?      @relation("UserManager", fields: [managerId], references: [id])
  directReports       User[]     @relation("UserManager")
  qualifications     UserQualification[]
  promotionRequests  PromotionRequest[] @relation("PromotionRequester")
  approvals           PromotionRequest[] @relation("PromotionApprover")
  careerHistory      CareerHistory[]

  @@index([teamId])
  @@index([roleId])
  @@index([currentRoleStepId])
  @@index([managerId])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  teamId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team      @relation(fields: [teamId], references: [id])
  steps       RoleStep[]
  users       User[]
  careerHistory CareerHistory[]

  @@unique([teamId, name])
  @@index([teamId])
}

model RoleStep {
  id                  String   @id @default(cuid())
  roleId              String
  code                StepCode
  label               String
  order               Int
  salary              Decimal  @db.Decimal(12, 2)
  minTenureMonths     Int?
  minExperienceMonths Int?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  role                Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  requirements        RoleStepQualification[]
  currentUsers        User[]   @relation("CurrentRoleStep")
  targetPromotions    PromotionRequest[] @relation("PromotionTargetStep")
  careerHistory       CareerHistory[]

  @@unique([roleId, code])
  @@unique([roleId, order])
  @@index([roleId])
}

model Qualification {
  id          String            @id @default(cuid())
  name        String
  type        QualificationType
  description String?
  referenceUrl String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  roleStepRequirements RoleStepQualification[]
  userQualifications   UserQualification[]

  @@unique([name, type])
}

model RoleStepQualification {
  id              String @id @default(cuid())
  roleStepId      String
  qualificationId String
  required        Boolean @default(true)
  notes           String?

  roleStep        RoleStep      @relation(fields: [roleStepId], references: [id], onDelete: Cascade)
  qualification   Qualification @relation(fields: [qualificationId], references: [id])

  @@unique([roleStepId, qualificationId])
  @@index([qualificationId])
}

model UserQualification {
  id              String              @id @default(cuid())
  userId          String
  qualificationId String
  status          QualificationStatus @default(PENDING)
  completedAt     DateTime?
  evidenceUrl     String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification   Qualification @relation(fields: [qualificationId], references: [id])

  @@unique([userId, qualificationId])
  @@index([qualificationId])
}

model PromotionRequest {
  id              String          @id @default(cuid())
  requesterId     String
  targetRoleStepId String
  status          PromotionStatus @default(DRAFT)
  requestedAt     DateTime?
  decidedAt       DateTime?
  approverId      String?
  decisionNotes   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  requester       User            @relation("PromotionRequester", fields: [requesterId], references: [id])
  targetRoleStep  RoleStep        @relation("PromotionTargetStep", fields: [targetRoleStepId], references: [id])
  approver        User?           @relation("PromotionApprover", fields: [approverId], references: [id])
  requirementSnapshots PromotionRequestQualification[]

  @@index([requesterId, status])
  @@index([approverId])
}

model PromotionRequestQualification {
  id                 String @id @default(cuid())
  promotionRequestId String
  qualificationName  String
  qualificationType  QualificationType
  required           Boolean
  metAtRequest       Boolean
  notes              String?

  promotionRequest   PromotionRequest @relation(fields: [promotionRequestId], references: [id], onDelete: Cascade)

  @@index([promotionRequestId])
}

model CareerHistory {
  id          String   @id @default(cuid())
  userId      String
  roleId      String
  roleStepId  String
  salary      Decimal  @db.Decimal(12, 2)
  startedAt   DateTime
  endedAt     DateTime?
  reason      String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  role        Role     @relation(fields: [roleId], references: [id])
  roleStep    RoleStep @relation(fields: [roleStepId], references: [id])

  @@index([userId, startedAt])
}
